{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/lesson.schema.json",
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "stage",
    "unitId",
    "order",
    "titleJa",
    "objectivesJa",
    "sections",
    "estimatedMinutes",
    "source"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contentRevision": { "type": "integer", "minimum": 1, "default": 1 },
    "stage": { "type": "integer", "minimum": 0, "maximum": 6 },
    "unitId": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1 },
    "titleJa": { "type": "string", "minLength": 1 },
    "descriptionJa": { "type": "string" },
    "objectivesJa": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "default": [] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "titleJa", "estimatedMinutes"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["explanation", "examples", "exercise", "recall", "speaking", "summary"] },
          "titleJa": { "type": "string" },
          "bodyJa": { "type": "string" },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["en", "ja"],
              "properties": {
                "en": { "type": "string" },
                "ja": { "type": "string" }
              }
            }
          },
          "exerciseIds": { "type": "array", "items": { "type": "string" } },
          "estimatedMinutes": { "type": "number", "minimum": 0 }
        }
      }
    },
    "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "reviewItemKeys": { "type": "array", "items": { "type": "string" }, "default": [] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "author"],
      "properties": {
        "type": { "const": "original" },
        "author": { "type": "string" }
      }
    }
  }
}
