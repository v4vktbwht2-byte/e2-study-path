{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/exercise.schema.json",
  "title": "Exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "type",
    "stage",
    "prompt",
    "payload",
    "answer",
    "explanation",
    "targetSkills",
    "targetMasteryDimensions",
    "estimatedSeconds",
    "source"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contentRevision": { "type": "integer", "minimum": 1, "default": 1 },
    "type": {
      "type": "string",
      "enum": [
        "multipleChoice",
        "multiSelect",
        "trueFalse",
        "textInput",
        "cloze",
        "sentenceOrder",
        "matching",
        "listenAndChoose",
        "dictation",
        "readingQuestion",
        "selfRecall",
        "writingPrompt",
        "speakingPrompt"
      ]
    },
    "stage": { "type": "integer", "minimum": 0, "maximum": 6 },
    "lessonId": { "type": "string" },
    "prompt": { "type": "string", "minLength": 1 },
    "instructionsJa": { "type": "string" },
    "payload": { "type": "object" },
    "answer": {},
    "explanation": { "type": "string", "minLength": 1 },
    "hints": { "type": "array", "items": { "type": "string" }, "default": [] },
    "targetSkills": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["vocabulary", "grammar", "reading", "listening", "writing", "speaking"] }
    },
    "targetMasteryDimensions": {
      "type": "array",
      "items": { "type": "string", "enum": ["recognition", "recall", "listening", "spelling", "context"] }
    },
    "reviewItemKeys": { "type": "array", "items": { "type": "string" }, "default": [] },
    "estimatedSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "author"],
      "properties": {
        "type": { "const": "original" },
        "author": { "type": "string" }
      }
    }
  }
}
