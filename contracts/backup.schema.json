{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/backup.schema.json",
  "title": "E2StudyPathBackup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportedAt",
    "appVersion",
    "contentVersions",
    "includedData",
    "data"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "appVersion": { "$ref": "#/$defs/semver" },
    "contentVersions": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/semver" }
    },
    "includedData": {
      "type": "array",
      "minItems": 10,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/section" },
      "allOf": [
        { "contains": { "const": "profiles" } },
        { "contains": { "const": "settings" } },
        { "contains": { "const": "reviewStates" } },
        { "contains": { "const": "mastery" } },
        { "contains": { "const": "vocabularyUserStates" } },
        { "contains": { "const": "lessonProgress" } },
        { "contains": { "const": "attempts" } },
        { "contains": { "const": "sessions" } },
        { "contains": { "const": "dailyPlans" } },
        { "contains": { "const": "writingSubmissions" } }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "settings",
        "reviewStates",
        "mastery",
        "vocabularyUserStates",
        "lessonProgress",
        "attempts",
        "sessions",
        "dailyPlans",
        "writingSubmissions"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/userProfile" }
        },
        "settings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/settings" }
        },
        "reviewStates": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewState" }
        },
        "mastery": {
          "type": "array",
          "items": { "$ref": "#/$defs/mastery" }
        },
        "vocabularyUserStates": {
          "type": "array",
          "items": { "$ref": "#/$defs/vocabularyUserState" }
        },
        "lessonProgress": {
          "type": "array",
          "items": { "$ref": "#/$defs/lessonProgress" }
        },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/attempt" }
        },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/studySession" }
        },
        "dailyPlans": {
          "type": "array",
          "items": { "$ref": "#/$defs/dailyPlan" }
        },
        "writingSubmissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/writingSubmission" }
        },
        "speakingRecordings": {
          "type": "array",
          "items": { "$ref": "#/$defs/serializedSpeakingRecording" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "includedData": {
            "contains": { "const": "speakingRecordings" }
          }
        }
      },
      "then": {
        "properties": {
          "data": { "required": ["speakingRecordings"] }
        }
      },
      "else": {
        "properties": {
          "data": { "not": { "required": ["speakingRecordings"] } }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "section": {
      "type": "string",
      "enum": [
        "profiles",
        "settings",
        "reviewStates",
        "mastery",
        "vocabularyUserStates",
        "lessonProgress",
        "attempts",
        "sessions",
        "dailyPlans",
        "writingSubmissions",
        "speakingRecordings"
      ]
    },
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "userProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt",
        "updatedAt",
        "goals",
        "dailyMinutes",
        "recommendedStage",
        "selectedStage",
        "onboardingCompleted"
      ],
      "properties": {
        "id": { "const": "local-user" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "goals": {
          "type": "array",
          "items": {
            "enum": ["grade2", "relearn", "conversation", "vocabulary"]
          }
        },
        "dailyMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "targetExamDate": { "$ref": "#/$defs/date" },
        "recommendedStage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "selectedStage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "onboardingCompleted": { "type": "boolean" },
        "diagnosticCompletedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "theme",
        "fontScale",
        "reducedMotion",
        "dailyNewVocabularyLimit",
        "reviewIntensity",
        "speechRate",
        "autoPlayAudio",
        "showKanaPronunciationGuide",
        "speedAdjustmentEnabled",
        "studyDayStartHour"
      ],
      "properties": {
        "id": { "const": "settings" },
        "theme": { "enum": ["system", "light", "dark"] },
        "fontScale": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 2
        },
        "reducedMotion": { "type": "boolean" },
        "dailyNewVocabularyLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reviewIntensity": {
          "enum": ["gentle", "standard", "strong"]
        },
        "speechRate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "autoPlayAudio": { "type": "boolean" },
        "showKanaPronunciationGuide": { "type": "boolean" },
        "speedAdjustmentEnabled": { "type": "boolean" },
        "studyDayStartHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        }
      }
    },
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemKey",
        "status",
        "learningStep",
        "intervalDays",
        "easeBias",
        "dueAt",
        "reviewCount",
        "lapseCount",
        "consecutiveSuccesses",
        "updatedAt"
      ],
      "properties": {
        "itemKey": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["new", "learning", "review", "relearning", "suspended"]
        },
        "learningStep": { "type": "integer", "minimum": 0 },
        "intervalDays": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "easeBias": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.3
        },
        "dueAt": { "type": "string", "format": "date-time" },
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "firstLearnedAt": { "type": "string", "format": "date-time" },
        "reviewCount": { "type": "integer", "minimum": 0 },
        "lapseCount": { "type": "integer", "minimum": 0 },
        "consecutiveSuccesses": { "type": "integer", "minimum": 0 },
        "predictedRetention": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lastRating": { "enum": ["again", "hard", "good", "easy"] },
        "lastResponseTimeMs": { "type": "integer", "minimum": 0 },
        "suspendedReason": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemKey",
        "recognition",
        "recall",
        "listening",
        "spelling",
        "context",
        "lastUpdatedAt"
      ],
      "properties": {
        "itemKey": { "type": "string", "minLength": 1 },
        "recognition": { "type": "number", "minimum": 0, "maximum": 100 },
        "recall": { "type": "number", "minimum": 0, "maximum": 100 },
        "listening": { "type": "number", "minimum": 0, "maximum": 100 },
        "spelling": { "type": "number", "minimum": 0, "maximum": 100 },
        "context": { "type": "number", "minimum": 0, "maximum": 100 },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "vocabularyUserState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemKey", "favorite", "note", "suspended", "updatedAt"],
      "properties": {
        "itemKey": { "type": "string", "minLength": 1 },
        "favorite": { "type": "boolean" },
        "note": { "type": "string" },
        "suspended": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lessonProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonId", "status", "currentSectionIndex", "updatedAt"],
      "properties": {
        "lessonId": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["notStarted", "inProgress", "completed", "skipped"]
        },
        "currentSectionIndex": { "type": "integer", "minimum": 0 },
        "bestScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "completedAt": { "type": "string", "format": "date-time" },
        "reviewCheckpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planDate",
            "blockId",
            "currentSectionIndex",
            "answeredExerciseIds",
            "updatedAt"
          ],
          "properties": {
            "planDate": { "$ref": "#/$defs/date" },
            "blockId": { "type": "string", "minLength": 1 },
            "currentSectionIndex": { "type": "integer", "minimum": 0 },
            "answeredExerciseIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "updatedAt": { "type": "string", "format": "date-time" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "itemKey",
        "sessionId",
        "createdAt",
        "studyDate",
        "mode",
        "response",
        "correct",
        "score",
        "responseTimeMs",
        "hintCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "itemKey": { "type": "string", "minLength": 1 },
        "exerciseId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "studyDate": { "$ref": "#/$defs/date" },
        "mode": { "type": "string", "minLength": 1 },
        "response": { "$ref": "#/$defs/jsonValue" },
        "correct": { "type": ["boolean", "null"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "responseTimeMs": { "type": "integer", "minimum": 0 },
        "hintCount": { "type": "integer", "minimum": 0 },
        "confidence": { "enum": ["none", "low", "medium", "high"] },
        "suggestedRating": { "enum": ["again", "hard", "good", "easy"] },
        "finalRating": { "enum": ["again", "hard", "good", "easy"] },
        "confusedWithItemKey": { "type": "string", "minLength": 1 }
      }
    },
    "studySession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "startedAt",
        "studyDate",
        "itemKeys",
        "completedItemKeys",
        "interrupted"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["daily", "lesson", "vocabulary", "review", "practice", "mock"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "studyDate": { "$ref": "#/$defs/date" },
        "plannedMinutes": { "type": "integer", "minimum": 0 },
        "itemKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "completedItemKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "interrupted": { "type": "boolean" }
      }
    },
    "dailyPlanBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "itemId", "category", "estimatedSeconds", "status"],
      "properties": {
        "blockId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "overdueReview",
            "dueReview",
            "weakItem",
            "currentLesson",
            "newVocabulary",
            "skillPractice"
          ]
        },
        "estimatedSeconds": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pending", "completed"] },
        "skill": {
          "enum": [
            "vocabulary",
            "grammar",
            "reading",
            "listening",
            "writing",
            "speaking"
          ]
        }
      }
    },
    "dailyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "generatedAt",
        "targetMinutes",
        "mode",
        "blocks",
        "completedBlockIds",
        "sourceSnapshot",
        "capacity",
        "plannedSeconds",
        "remainingBudgetSeconds"
      ],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "targetMinutes": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["light", "standard", "thorough", "all"] },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/dailyPlanBlock" }
        },
        "completedBlockIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dueCount", "overdueCount", "newLimit"],
          "properties": {
            "dueCount": { "type": "integer", "minimum": 0 },
            "overdueCount": { "type": "integer", "minimum": 0 },
            "newLimit": { "type": "integer", "minimum": 0 }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedMinutes",
            "effectiveMinutes",
            "budgetSeconds",
            "estimatedReviewItemCapacity"
          ],
          "properties": {
            "requestedMinutes": { "type": "integer", "minimum": 1 },
            "effectiveMinutes": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "budgetSeconds": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "estimatedReviewItemCapacity": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "plannedSeconds": { "type": "integer", "minimum": 0 },
        "remainingBudgetSeconds": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "opinionOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opinion", "reason1", "detail1", "reason2", "detail2", "conclusion"],
      "properties": {
        "opinion": { "type": "string" },
        "reason1": { "type": "string" },
        "detail1": { "type": "string" },
        "reason2": { "type": "string" },
        "detail2": { "type": "string" },
        "conclusion": { "type": "string" }
      }
    },
    "writingSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "promptId",
        "type",
        "draft",
        "wordCount",
        "checklist",
        "summaryMemo",
        "opinionOutline",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "promptId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["summary", "opinion"] },
        "draft": { "type": "string" },
        "wordCount": { "type": "integer", "minimum": 0 },
        "checklist": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "summaryMemo": { "type": "string" },
        "opinionOutline": { "$ref": "#/$defs/opinionOutline" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "serializedSpeakingRecording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "promptId",
        "createdAt",
        "durationMs",
        "mimeType",
        "sizeBytes",
        "dataBase64",
        "selfAssessment"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "promptId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "mimeType": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^audio\\/(webm|ogg|mp4|mpeg|wav)(;\\s*codecs=[A-Za-z0-9._,+-]+)?$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "dataBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "selfAssessment": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "string" }]
          }
        }
      }
    }
  }
}
