{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/review-state.schema.json",
  "title": "ReviewState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "itemKey",
    "status",
    "learningStep",
    "intervalDays",
    "easeBias",
    "dueAt",
    "reviewCount",
    "lapseCount",
    "consecutiveSuccesses",
    "updatedAt"
  ],
  "properties": {
    "itemKey": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["new", "learning", "review", "relearning", "suspended"] },
    "learningStep": { "type": "integer", "minimum": 0 },
    "intervalDays": { "type": "number", "minimum": 0, "maximum": 180 },
    "easeBias": { "type": "number", "minimum": 0.75, "maximum": 1.3 },
    "dueAt": { "type": "string", "format": "date-time" },
    "lastReviewedAt": { "type": "string", "format": "date-time" },
    "firstLearnedAt": { "type": "string", "format": "date-time" },
    "reviewCount": { "type": "integer", "minimum": 0 },
    "lapseCount": { "type": "integer", "minimum": 0 },
    "consecutiveSuccesses": { "type": "integer", "minimum": 0 },
    "predictedRetention": { "type": "number", "minimum": 0, "maximum": 1 },
    "lastRating": { "type": "string", "enum": ["again", "hard", "good", "easy"] },
    "lastResponseTimeMs": { "type": "integer", "minimum": 0 },
    "suspendedReason": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
