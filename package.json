{
  "name": "e2-study-path",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "英語初学者向けのモバイルファースト・オフライン優先学習PWA",
  "engines": {
    "node": ">=24.13.1",
    "npm": ">=11.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src e2e \"scripts/**/*.{ts,mjs}\" package.json vite.config.ts playwright.config.ts eslint.config.js prettier.config.mjs \"tsconfig*.json\"",
    "format:check": "prettier --check src e2e \"scripts/**/*.{ts,mjs}\" package.json vite.config.ts playwright.config.ts eslint.config.js prettier.config.mjs \"tsconfig*.json\"",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:dist": "node scripts/verify-production-build.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate:content && npm run build"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "dexie": "4.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
