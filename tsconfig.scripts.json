{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/content/pilot/*.ts",
    "src/infrastructure/content/schemas.ts",
    "src/infrastructure/content/validatePack.ts"
  ],
  "exclude": ["src/content/pilot/**/*.test.ts"]
}
